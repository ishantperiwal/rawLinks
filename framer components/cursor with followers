import React, { useEffect, useRef } from "react"
import {
    motion,
    useSpring,
    useTime,
    useTransform,
    useMotionValue,
} from "framer-motion"
import { ControlType } from "framer"

const globalSpeedFactor = 2.5

function getScaleFromElement(el) {
    if (!el) return { scaleX: 1, scaleY: 1 }

    const transform = window.getComputedStyle(el).transform
    if (!transform || transform === "none") return { scaleX: 1, scaleY: 1 }

    // matrix(a, b, c, d, tx, ty)
    const match = transform.match(/matrix\((.+)\)/)
    if (!match) return { scaleX: 1, scaleY: 1 }

    const values = match[1].split(",").map((v) => parseFloat(v.trim()))
    if (values.length < 6) return { scaleX: 1, scaleY: 1 }

    const [a, b, c, d] = values

    // scaleX = sqrt(a² + b²)
    // scaleY = sqrt(c² + d²)
    const scaleX = Math.sqrt(a * a + b * b)
    const scaleY = Math.sqrt(c * c + d * d)

    return {
        scaleX: scaleX || 1,
        scaleY: scaleY || 1,
    }
}

export default function FlowerCursor(props) {
    const {
        flowerImage,
        beeImage,
        size = 50,
        beeSize = 30,
        buzzSpeed = 0.5,
        buzzIntensity = 12,
        bee1OffsetX = -45,
        bee1OffsetY = 45,
        bee2OffsetX = 45,
        bee2OffsetY = 25,
        stiffness = 180,
        damping = 25,

        // manual tweak if needed
        cursorOffsetX = 220,
        cursorOffsetY = 220,
    } = props

    const mouseX = useMotionValue(0)
    const mouseY = useMotionValue(0)

    const targetB1X = useMotionValue(0)
    const targetB1Y = useMotionValue(0)
    const targetB2X = useMotionValue(0)
    const targetB2Y = useMotionValue(0)

    const scaledStiffness = stiffness / (globalSpeedFactor * globalSpeedFactor)
    const scaledDamping = damping / globalSpeedFactor

    const beeConfig = {
        stiffness: scaledStiffness,
        damping: scaledDamping,
        mass: 1.2,
    }

    const fX = useSpring(mouseX, { stiffness: 1000, damping: 50 })
    const fY = useSpring(mouseY, { stiffness: 1000, damping: 50 })

    const b1X = useSpring(targetB1X, beeConfig)
    const b1Y = useSpring(targetB1Y, beeConfig)

    const b2X = useSpring(targetB2X, beeConfig)
    const b2Y = useSpring(targetB2Y, beeConfig)

    const lastPos = useRef({ x: 0, y: 0, t: Date.now() })
    const isHalted = useRef(false)
    const velocityThreshold = 0.6

    useEffect(() => {
        const handleMove = (e) => {
            // Find scale from Framer preview/canvas transforms
            const { scaleX, scaleY } = getScaleFromElement(
                document.querySelector("#__framer-root") ||
                    document.body ||
                    document.documentElement
            )

            // Correct coordinates by scale
            const x = e.clientX / scaleX + cursorOffsetX
            const y = e.clientY / scaleY + cursorOffsetY

            const now = Date.now()
            const dt = now - lastPos.current.t
            const dx = x - lastPos.current.x
            const dy = y - lastPos.current.y
            const velocity = Math.sqrt(dx * dx + dy * dy) / (dt || 1)

            mouseX.set(x)
            mouseY.set(y)

            if (velocity < velocityThreshold) {
                if (!isHalted.current) {
                    targetB1X.set(x + bee1OffsetX)
                    targetB1Y.set(y + bee1OffsetY)
                    targetB2X.set(x + bee2OffsetX)
                    targetB2Y.set(y + bee2OffsetY)
                    isHalted.current = true
                }
            } else {
                isHalted.current = false
            }

            lastPos.current = { x, y, t: now }
        }

        window.addEventListener("mousemove", handleMove, { passive: true })
        return () => window.removeEventListener("mousemove", handleMove)
    }, [
        bee1OffsetX,
        bee1OffsetY,
        bee2OffsetX,
        bee2OffsetY,
        cursorOffsetX,
        cursorOffsetY,
    ])

    const time = useTime()

    const b1BuzzX = useTransform(
        time,
        (t) => Math.sin(t * 0.005 * buzzSpeed) * buzzIntensity
    )
    const b1BuzzY = useTransform(
        time,
        (t) => Math.cos(t * 0.004 * buzzSpeed) * buzzIntensity
    )

    const b2BuzzX = useTransform(
        time,
        (t) => Math.cos(t * 0.005 * buzzSpeed) * buzzIntensity
    )
    const b2BuzzY = useTransform(
        time,
        (t) => Math.sin(t * 0.006 * buzzSpeed) * buzzIntensity
    )

    const baseStyle = {
        position: "fixed",
        top: 0,
        left: 0,
        width: 0,
        height: 0,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        pointerEvents: "none",
        zIndex: 999999,
        willChange: "transform",
    }

    return (
        <div style={{ position: "fixed", inset: 0, pointerEvents: "none" }}>
            {/* Flower */}
            <motion.div style={{ ...baseStyle, x: fX, y: fY }}>
                <img
                    src={flowerImage}
                    style={{
                        width: size,
                        height: size,
                        transform: "translate(-50%, -50%)",
                    }}
                />
            </motion.div>

            {/* Bee 1 */}
            <motion.div style={{ ...baseStyle, x: b1X, y: b1Y }}>
                <motion.div style={{ x: b1BuzzX, y: b1BuzzY }}>
                    <img
                        src={beeImage}
                        style={{
                            width: beeSize,
                            height: beeSize,
                            transform: "translate(-50%, -50%)",
                        }}
                    />
                </motion.div>
            </motion.div>

            {/* Bee 2 */}
            <motion.div style={{ ...baseStyle, x: b2X, y: b2Y }}>
                <motion.div style={{ x: b2BuzzX, y: b2BuzzY }}>
                    <img
                        src={beeImage}
                        style={{
                            width: beeSize,
                            height: beeSize,
                            transform: "translate(-50%, -50%)",
                        }}
                    />
                </motion.div>
            </motion.div>
        </div>
    )
}

FlowerCursor.propertyControls = {
    flowerImage: { type: ControlType.Image, title: "Flower" },
    beeImage: { type: ControlType.Image, title: "Bee" },

    size: { type: ControlType.Number, title: "Flower Size", defaultValue: 50 },
    beeSize: { type: ControlType.Number, title: "Bee Size", defaultValue: 30 },

    stiffness: {
        type: ControlType.Number,
        title: "Spring Stiffness",
        defaultValue: 180,
    },
    damping: {
        type: ControlType.Number,
        title: "Spring Damping",
        defaultValue: 25,
    },

    bee1OffsetX: {
        type: ControlType.Number,
        title: "Bee 1 X",
        defaultValue: -45,
    },
    bee1OffsetY: {
        type: ControlType.Number,
        title: "Bee 1 Y",
        defaultValue: 45,
    },

    bee2OffsetX: {
        type: ControlType.Number,
        title: "Bee 2 X",
        defaultValue: 45,
    },
    bee2OffsetY: {
        type: ControlType.Number,
        title: "Bee 2 Y",
        defaultValue: 25,
    },

    buzzSpeed: {
        type: ControlType.Number,
        title: "Buzz Speed",
        defaultValue: 0.5,
        step: 0.1,
    },
    buzzIntensity: {
        type: ControlType.Number,
        title: "Buzz Dist",
        defaultValue: 12,
    },

    cursorOffsetX: {
        type: ControlType.Number,
        title: "Cursor Offset X",
        defaultValue: 0,
    },
    cursorOffsetY: {
        type: ControlType.Number,
        title: "Cursor Offset Y",
        defaultValue: 0,
    },
}
